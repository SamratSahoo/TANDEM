Make pyrealsense2 an optional extra rather than a hard dependency.

The FR3 + ZED pipeline never imports it — tiptop/perception/cameras/rs_camera.py is only
loaded when a camera is configured with type "realsense" — but as a required dependency it
has to resolve for every install, and its wheels are large and are missing outright for some
Python/platform combinations. As an extra, a rig without a RealSense does not have to
satisfy it, and one with a RealSense installs `tiptop[realsense]`.

--- a/pyproject.toml
+++ b/pyproject.toml
@@ -29,7 +29,6 @@
     "numpy",
     "omegaconf",
     "opencv-python>=4.12,<4.13",  # API changes too often
-    "pyrealsense2",
     "rerun-sdk==0.27.3",  # API changes too often
     "ruamel.yaml",
     "scipy",
@@ -41,6 +40,9 @@
 ]

 [project.optional-dependencies]
+realsense = [
+    "pyrealsense2",
+]
 ur5 = [
     "ur_rtde",
 ]
