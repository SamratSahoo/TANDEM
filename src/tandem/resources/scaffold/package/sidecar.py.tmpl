#!/usr/bin/env python3
"""{{title}}'s sidecar: the planner itself, run by tandem in the planner's own environment.

tandem launches this script with the runtime's interpreter (``{{class_name}}.recipe``; tandem's own
until one is declared) and talks to it one JSON object per line: a request names a verb and its
arguments, and the handler of that name answers with a JSON-safe dict. ``tandem_sidecar`` does the
talking. Its docstring lists what every verb is sent and must return.

Two rules, both checked by tandem's conformance kit:

- **Never import tandem.** The planner's environment does not have it, and should not need it.
  ``tandem_sidecar`` is not tandem: it is one standard-library file tandem puts on this script's path.
- **Import tandem_sidecar before anything but the standard library.** It takes stdout for the
  protocol when it is imported. Anything a library prints on import after that goes to stderr, which
  tandem shows in the session log; printed before it, one CUDA banner would corrupt the channel.

Never import this module either: it is a script, and importing it would take the importer's stdout.

As generated it serves a stand-in world -- one block, one tray, a table -- so the kit passes before
the real planner is wired in. Replace each TODO, and import the planner's heavy libraries in warm().
"""

from __future__ import annotations

import json
import shutil
import struct
import tempfile
import time
import uuid
import zlib
from pathlib import Path

from tandem_sidecar import log, serve

# isort: split
# The planner's own imports go below here, never above -- or better, inside World.warm(), so that a
# library that fails to import is reported as a failed warm-up rather than a sidecar that never said
# hello.


class World:
    """TODO: the real planner. Its methods are the verbs the sidecar answers."""

    def __init__(self) -> None:
        self.where = {"block": "table"}
        self.scenes: dict[str, dict[str, str]] = {}
        self.plans: dict[str, list[list[str]]] = {}
        self.frames = Path(tempfile.mkdtemp(prefix="{{name}}-frames-"))

    def warm(self, *, output_dir=None, execute=True, record=True, **_planner_specific):
        # TODO: import the heavy libraries, open the cameras, connect the robot, build the solvers.
        # output_dir is where tandem files finished legs; execute False means plan without moving.
        log("{{name}}: warm (the stand-in world needs nothing)")
        return {}

    def close(self):
        # TODO: release everything warm() opened. Also called when tandem goes away without asking.
        shutil.rmtree(self.frames, ignore_errors=True)
        return {}

    def perceive(self, *, task_hint, save_dir, reset_arm=True, open_gripper=False):
        # TODO: look at the workspace. task_hint is the whole instruction, to steer detection. Park the
        # arm first when reset_arm; open the gripper first when open_gripper (after a human phase).
        scene_id = uuid.uuid4().hex[:8]
        self.scenes[scene_id] = dict(self.where)
        return {
            "scene_id": scene_id,
            "object_labels": ["block", "tray"],
            "table_label": "table",
            "surface_labels": ["tray"],
            # An image of what was seen: tandem splits the task into phases from it, so without one no
            # task can be planned.
            "rgb_path": _stand_in_image(Path(save_dir) / "perception_rgb.png"),
        }

    def capture_frame(self, *, camera="external"):
        # TODO: one frame from that camera, written to a file. tandem checks a person's work on a human
        # phase from it, so it must be a real, current frame -- never a stale or made-up one.
        return {"path": _stand_in_image(self.frames / f"{camera}-{uuid.uuid4().hex[:8]}.png")}

    def plan(
        self, *, scene_id, goal, surfaces, save_dir, movables=None, return_home=True, reuse_skeleton=None
    ):
        # TODO: plan for the goal -- [{"predicate": "at", "args": ["block", "tray"]}] -- in the scene
        # scene_id names. A goal that cannot be planned is {"ok": False, "failure_reason": ...}.
        # movables and return_home arrive only once CAPABILITIES declares them supported.
        started = time.monotonic()
        scene = self.scenes.get(scene_id)
        if scene is None:
            return {"ok": False, "failure_reason": f"unknown scene {scene_id!r}: perceive again first"}
        moves = []
        for atom in goal:
            args = list(atom.get("args") or [])
            if atom.get("predicate") != "at" or len(args) != 2:
                return {"ok": False, "failure_reason": f"cannot plan {atom}"}
            if args[0] not in scene:
                return {"ok": False, "failure_reason": f"{args[0]} is not an object this scene has"}
            moves.append(args)
        plan_id = uuid.uuid4().hex[:8]
        self.plans[plan_id] = moves
        return {
            "ok": True,
            "planning_seconds": time.monotonic() - started,
            # Handed back to execute() as it is: it must be JSON-safe, since it crosses the wire.
            "plan_handle": plan_id,
            # The operators the plan runs, object arguments only: written into the rollout's record.
            "task_plan": [f"Move({obj}, {place})" for obj, place in moves],
        }

    def execute(self, *, plan_handle, leg, save_dir):
        # TODO: run the plan on the robot and record it as one leg of leg["trajectory_id"]. The recording
        # contract -- robot_state.npz, the camera clips, _meta.json -- is in the docstring of
        # tandem.planners.sdk.Planner.execute; once it is met, set records_legs = True in
        # tests/test_conformance.py. The stand-in only stamps _meta.json, which is what lets tandem's
        # merge find the leg at all: stamp it even when execution fails part-way.
        start = time.time()
        for obj, place in self.plans.pop(plan_handle, []):
            self.where[obj] = place
        directory = Path(save_dir)
        directory.mkdir(parents=True, exist_ok=True)
        meta = {
            "trajectory_id": leg["trajectory_id"],
            "segment_source": leg["segment_source"],
            "instruction": leg.get("instruction", ""),
            "record_start": start,
            "record_stop": time.time(),
            "fps": 15,
            "cameras": {},
        }
        if leg.get("phase_index") is not None:
            meta.update(
                phase_index=leg["phase_index"],
                n_phases=leg.get("n_phases"),
                phase_description=leg.get("phase_description", ""),
            )
        (directory / "_meta.json").write_text(json.dumps(meta, indent=2))
        return {"ok": True, "n_frames": 0, "rollout_dir": str(directory)}

    # TODO: home(), release_hardware() and reacquire_hardware(), once the planner holds a robot and
    # cameras. A verb with no method here falls back to tandem's default: nothing, for the hardware
    # verbs; "not supported", for capture_frame.


def _stand_in_image(path: Path, width: int = 64, height: int = 48) -> str:
    """TODO: delete once perceive and capture_frame return real camera images. A plain grey PNG.

    Written with the standard library alone, because this environment is the planner's, and nothing
    here may assume an imaging library is in it.
    """

    def chunk(kind: bytes, data: bytes) -> bytes:
        return struct.pack(">I", len(data)) + kind + data + struct.pack(">I", zlib.crc32(kind + data))

    row = b"\x00" + bytes((120, 140, 160)) * width
    header = struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0)
    png = b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", header) + chunk(b"IDAT", zlib.compress(row * height))
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_bytes(png + chunk(b"IEND", b""))
    return str(path)


if __name__ == "__main__":
    # serve() answers every protocol verb World has a method for, until tandem says quit.
    raise SystemExit(serve(World()))
