"""{{title}}: a planner tandem can drive, running in tandem's own process.

Generated by `tandem planners new {{name}}`. As it stands it plans in a stand-in world -- one block,
one tray, a table -- and "executes" in memory, so tandem's conformance kit passes before any real
planner is wired in (`pytest`). Replace each TODO with the real thing and keep the kit green.

What tandem needs from a planner is narrow: what a goal may say (CAPABILITIES), what is in the scene
(perceive), a plan for one goal (plan), and that plan run on the robot and recorded (execute).
Everything else -- splitting a task into robot and human phases, teleop, checking a person's work,
merging the legs into one demonstration -- is tandem's. ``tandem.planners.sdk.Planner`` documents
each method's contract, and the default of every method not written here.

This module is imported to LIST planners, on machines that will never run this one: keep torch, CUDA
and robot clients out of its top level. Import them inside ``warm()`` -- or, if the planner needs an
environment of its own, run it as a sidecar (`tandem planners new NAME --sidecar` shows how).
"""

from __future__ import annotations

import json
import shutil
import tempfile
import time
import uuid
from pathlib import Path

from tandem.planners import (
    Capabilities,
    ExecuteResult,
    Parameter,
    Planner,
    PlannerInfo,
    PlanResult,
    Predicate,
    SceneView,
)

# TODO: the goal language -- every predicate a robot phase's goal may be stated in, with typed
# parameters. The phase planner shows these to the model that splits a task into phases, so a
# person reads them: name them for that reader.
AT = Predicate("At", (Parameter("obj", "movable"), Parameter("place", "surface")))

CAPABILITIES = Capabilities(
    name="{{name}}",
    goal_predicates={"At": AT},
    # TODO: one sentence, in abstract terms, of what the robot can physically do.
    robot_description="move an object to a place",
    # How each goal predicate is spelled in the goal plan() receives. A predicate left out here is
    # one the planner supplies for itself: it is dropped from goals rather than sent.
    goal_predicate_wire_names={"At": "at"},
    # What some operator of the planner can make true. A phase asking for anything else is refused
    # before perception is paid for.
    achievable_predicates=frozenset({"At"}),
    # Names a model may not reuse for a predicate it invents. At least the goal predicates.
    reserved_predicate_names=frozenset({"At"}),
    movable_type="movable",
    surface_type="surface",
    # What each predicate means in words, {0}-style: what an operator is told a phase leaves true.
    predicate_descriptions={"At": "{0} is at {1}"},
    # Predicates a camera can judge from one photo, so a phase asking for them can be checked.
    checkable_predicates=frozenset({"At"}),
    # An object is at one place at a time: asserting At(block, tray) ends At(block, table).
    exclusive_arguments={"At": 0},
    # The object a robot phase moves is At's first argument; the place is not moved.
    moved_arguments={"At": 0},
    # The planner's own operators, for the record of each rollout. Never shown to the model.
    robot_operators=("Move(?obj: movable, ?place: surface)",),
    # TODO: what the solver assumes. initial_state_is_clean=True makes tandem plan consecutive robot
    # phases as ONE goal -- one perception pass, the atoms sorted, the proposer's order between them
    # dropped -- which is sound only if every goal is planned from the same state and nothing symbolic
    # orders two phases. This stand-in keeps where things are between legs, so it is False: every robot
    # phase is its own leg. one_pick_per_object=True keeps two phases that move the same object apart.
    initial_state_is_clean=False,
    one_pick_per_object=True,
    # TODO: switch each on once plan()/execute() honour it; the conformance kit then checks it.
    # movable restriction: plan(movables=...) picks only those objects. Return home: plan(return_home=
    # False) ends where the last operation leaves the arm. Cooperative stop: execute polls should_stop.
    supports_movable_restriction=False,
    supports_return_home=False,
    supports_cooperative_stop=False,
)


class {{class_name}}(Planner):
    """{{title}}. TODO: say what it plans with, and what it drives."""

    info = PlannerInfo(
        name="{{name}}",
        display_name="{{title}}",
        # TODO: one sentence for `tandem planners list`.
        summary="A new planner: plans in a stand-in world until its TODOs are filled in.",
        # TODO: what a machine needs before it can run the planner, one line each ("an NVIDIA GPU").
        requires=(),
    )
    CAPABILITIES = CAPABILITIES
    # TODO: if the planner needs more than pip -- torch, compiled kernels, a solver with an environment
    # of its own -- declare its runtime as a tandem.planners.RuntimeRecipe (pinned sources, a pixi
    # environment, build steps), and `tandem planners install {{name}}` builds it. None: pure Python.
    recipe = None
    # TODO: the TASK's settings it reads, in each profile's planner.options, one line each saying what it
    # does. Any other key is refused, not ignored, when a profile naming the planner loads. For options
    # with types or structure, override validate_options(options) as well; for what `tandem doctor`
    # should check (a server it calls, a GPU), doctor_checks(profile, *, settings, probe_hardware).
    OPTIONS = {}
    # TODO: settings of THIS MACHINE it reads -- a robot's ports, a server's address -- each with one line.
    # They live in the rig (rig.yml, under planners.{{name}}) and every profile shares them: `tandem rig set
    # planners.{{name}}.KEY VALUE`. OPTIONS above are the TASK's, one set per profile. No key in both.
    # The rig's own robot.host, robot.type and cameras are self.rig's; validate_rig_options checks these.
    RIG_OPTIONS = {}

    def __init__(self, ctx=None) -> None:
        super().__init__(ctx)
        # Nothing heavy here: a backend is built before the session is sure it will run. Open hardware
        # and build solvers in warm(); release them in close().
        # TODO: replace the stand-in world with the planner's own state.
        self._where = {"block": "table"}
        self._scenes: dict[str, dict[str, str]] = {}
        self._plans: dict[str, list[tuple[str, str]]] = {}
        self._frames: Path | None = None

    def close(self) -> None:
        # TODO: release everything warm() opened. Must be safe twice, and on a planner never warmed.
        if self._frames is not None:
            shutil.rmtree(self._frames, ignore_errors=True)
            self._frames = None

    def perceive(
        self,
        *,
        task_hint: str,
        save_dir: Path,
        reset_arm: bool = True,
        open_gripper: bool = False,
    ) -> SceneView:
        # TODO: look at the workspace. task_hint is the whole instruction, to steer detection. Park the
        # arm first when reset_arm; open the gripper first when open_gripper (after a human phase).
        # Return every object's label, the support surface's (not among the objects), which objects are
        # surfaces, a scene_id plan() is handed back, and rgb_path, an image of what was seen: tandem
        # splits the task into phases from that image, so without one no task can be planned.
        scene_id = uuid.uuid4().hex[:8]
        self._scenes[scene_id] = dict(self._where)
        return SceneView(
            object_labels=("block", "tray"),
            table_label="table",
            surface_labels=frozenset({"tray"}),
            scene_id=scene_id,
            rgb_path=_stand_in_image(Path(save_dir) / "perception_rgb.png"),
        )

    def capture_frame(self, *, camera: str = "external") -> str:
        # TODO: one frame from that camera, written to a file; its path. tandem checks a person's work
        # on a human phase from it, so it must be a real, current frame -- never a stale or made-up one.
        if self._frames is None:
            self._frames = Path(tempfile.mkdtemp(prefix="{{name}}-frames-"))
        return _stand_in_image(self._frames / f"{camera}-{uuid.uuid4().hex[:8]}.png")

    def plan(
        self,
        scene_id: str,
        goal,
        *,
        surfaces: frozenset[str] = frozenset(),
        movables: frozenset[str] | None = None,
        return_home: bool = True,
        save_dir: Path,
        reuse_skeleton=None,
    ) -> PlanResult:
        # TODO: plan for the goal -- atoms in the wire spelling, {"at", ("block", "tray")} -- in the scene
        # scene_id names. A goal that cannot be planned is ok=False with the reason, not an exception.
        # movables and return_home are passed only once CAPABILITIES declares them supported.
        started = time.monotonic()
        scene = self._scenes.get(scene_id)
        if scene is None:
            return PlanResult(ok=False, failure_reason=f"unknown scene {scene_id!r}: perceive again first")
        moves = []
        for atom in goal:
            if atom.predicate != "at" or len(atom.args) != 2:
                return PlanResult(ok=False, failure_reason=f"cannot plan {atom.predicate}{tuple(atom.args)}")
            obj, place = atom.args
            if obj not in scene:
                return PlanResult(ok=False, failure_reason=f"{obj} is not an object this scene has")
            moves.append((obj, place))
        plan_id = uuid.uuid4().hex[:8]
        self._plans[plan_id] = moves
        return PlanResult(
            ok=True,
            planning_seconds=time.monotonic() - started,
            plan_handle=plan_id,
            # The operators the plan runs, object arguments only: written into the rollout's record.
            task_plan=tuple(f"Move({obj}, {place})" for obj, place in moves),
        )

    def execute(self, plan_handle, leg, *, save_dir: Path, should_stop=None) -> ExecuteResult:
        # TODO: run the plan on the robot and record it as one leg of leg.trajectory_id. The recording
        # contract -- robot_state.npz, the camera clips, _meta.json -- is in the docstring of
        # tandem.planners.sdk.Planner.execute; once it is met, set records_legs = True in
        # tests/test_conformance.py. The stand-in only stamps _meta.json, which is what lets tandem's
        # merge find the leg at all: stamp it even when execution fails part-way.
        start = time.time()
        for obj, place in self._plans.pop(plan_handle, []):
            self._where[obj] = place
        save_dir = Path(save_dir)
        save_dir.mkdir(parents=True, exist_ok=True)
        meta = {
            "trajectory_id": leg.trajectory_id,
            "segment_source": leg.segment_source,
            "instruction": leg.instruction,
            "record_start": start,
            "record_stop": time.time(),
            "fps": 15,
            "cameras": {},
        }
        if leg.phase_index is not None:
            meta.update(
                phase_index=leg.phase_index,
                n_phases=leg.n_phases,
                phase_description=leg.phase_description,
            )
        (save_dir / "_meta.json").write_text(json.dumps(meta, indent=2))
        return ExecuteResult(ok=True, n_frames=0, rollout_dir=str(save_dir))

    # TODO: warm(), home(), release_hardware() and reacquire_hardware() default to doing nothing:
    # override them once the planner holds hardware.


def _stand_in_image(path: Path) -> str:
    """TODO: delete once perceive and capture_frame return real camera images. A plain grey frame."""
    from PIL import Image  # tandem's own dependency, imported only when a frame is written

    path.parent.mkdir(parents=True, exist_ok=True)
    Image.new("RGB", (64, 48), (120, 140, 160)).save(path)
    return str(path)
