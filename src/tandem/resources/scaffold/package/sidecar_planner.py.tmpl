"""{{title}}: a planner tandem can drive, running as a sidecar in an environment of its own.

Generated by `tandem planners new {{name}} --sidecar`. A planner that needs torch, CUDA kernels, a
camera SDK or a robot client cannot run inside tandem, which installs with pip on a laptop. So it is
two halves:

- this class, in tandem's process: WHAT the planner is (its declarations) and HOW it is launched.
  ``tandem.planners.sidecar.SidecarPlanner`` does the rest -- starts the sidecar, maps every verb onto
  a JSON request and the reply back onto tandem's types, times verbs out, reports a crash, and stops
  the process so nothing is left holding a camera;
- ``sidecar.py``, run by the planner's own interpreter: the planner itself, answering perceive, plan
  and execute. It imports nothing from tandem -- only ``tandem_sidecar``, which tandem puts on its
  path.

As generated there is no runtime yet (``recipe = None``), so the sidecar runs under tandem's own
interpreter and serves a stand-in world, and tandem's conformance kit passes (`pytest`). Replace
each TODO with the real thing and keep the kit green.

This module is imported to LIST planners: keep it as light as it is now.
"""

from __future__ import annotations

from tandem.planners import Capabilities, Parameter, PlannerInfo, Predicate, SidecarPlanner

# TODO: the goal language -- every predicate a robot phase's goal may be stated in, with typed
# parameters. The phase planner shows these to the model that splits a task into phases, so a
# person reads them: name them for that reader.
AT = Predicate("At", (Parameter("obj", "movable"), Parameter("place", "surface")))

CAPABILITIES = Capabilities(
    name="{{name}}",
    goal_predicates={"At": AT},
    # TODO: one sentence, in abstract terms, of what the robot can physically do.
    robot_description="move an object to a place",
    # How each goal predicate is spelled in the goal the sidecar's plan() receives. A predicate left
    # out here is one the planner supplies for itself: it is dropped from goals rather than sent.
    goal_predicate_wire_names={"At": "at"},
    # What some operator of the planner can make true. A phase asking for anything else is refused
    # before perception is paid for.
    achievable_predicates=frozenset({"At"}),
    # Names a model may not reuse for a predicate it invents. At least the goal predicates.
    reserved_predicate_names=frozenset({"At"}),
    movable_type="movable",
    surface_type="surface",
    # What each predicate means in words, {0}-style: what an operator is told a phase leaves true.
    predicate_descriptions={"At": "{0} is at {1}"},
    # Predicates a camera can judge from one photo, so a phase asking for them can be checked.
    checkable_predicates=frozenset({"At"}),
    # An object is at one place at a time: asserting At(block, tray) ends At(block, table).
    exclusive_arguments={"At": 0},
    # The object a robot phase moves is At's first argument; the place is not moved.
    moved_arguments={"At": 0},
    # The planner's own operators, for the record of each rollout. Never shown to the model.
    robot_operators=("Move(?obj: movable, ?place: surface)",),
    # TODO: what the solver assumes. initial_state_is_clean=True makes tandem plan consecutive robot
    # phases as ONE goal -- one perception pass, the atoms sorted, the proposer's order between them
    # dropped -- which is sound only if every goal is planned from the same state and nothing symbolic
    # orders two phases. The stand-in sidecar keeps where things are between legs, so it is False:
    # every robot phase is its own leg. one_pick_per_object=True keeps two phases that move the same
    # object apart.
    initial_state_is_clean=False,
    one_pick_per_object=True,
    # TODO: switch each on once the sidecar honours it; the conformance kit then checks it. The
    # sidecar's plan() is sent movables / return_home only once they are declared here, and a stop
    # reaches it through tandem_sidecar.should_stop() only once cooperative stop is.
    supports_movable_restriction=False,
    supports_return_home=False,
    supports_cooperative_stop=False,
)


class {{class_name}}(SidecarPlanner):
    """{{title}}. TODO: say what it plans with, and what it drives."""

    info = PlannerInfo(
        name="{{name}}",
        display_name="{{title}}",
        # TODO: one sentence for `tandem planners list`.
        summary="A new planner: plans in a stand-in world until its TODOs are filled in.",
        # TODO: what a machine needs before it can run the planner, one line each ("an NVIDIA GPU").
        requires=(),
    )
    CAPABILITIES = CAPABILITIES
    # The script the planner's interpreter runs, next to this module.
    SIDECAR = "sidecar.py"
    # TODO: the environment the sidecar runs in, as a tandem.planners.RuntimeRecipe: the planner's
    # sources pinned to exact commits, a pixi environment solved from its manifest, and the build steps
    # to run in it. `tandem planners install {{name}}` then builds it, and the sidecar is launched with
    # that environment's python. None runs the sidecar with tandem's own interpreter.
    recipe = None
    # TODO: seconds each verb may take before the sidecar is reported as wedged, over the defaults
    # (tandem.planners.sidecar.DEFAULT_TIMEOUTS), e.g. {"warm": 600.0}.
    TIMEOUTS = {}
    # TODO: the planner.options keys it reads from a profile, each with one line saying what it does.
    # Hand them to the sidecar by overriding warm_args(). Any other key is refused when a profile naming
    # the planner loads; override validate_options(options) for types or structure, and
    # doctor_checks(profile, *, settings, probe_hardware) for what `tandem doctor` should check.
    OPTIONS = {}
